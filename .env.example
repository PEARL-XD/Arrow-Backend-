PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./data/wallet.sqlite
# SQLite above is local development only. Render/production require MongoDB.
# Create a dedicated Arrow database/user, not your other project's database.
MONGODB_URI=
MONGODB_DATABASE=arrow_lantern_sandbox
# Separate database and deployment for sandbox and production. Never mix them.
STORE_ENVIRONMENT=sandbox
# Checkout remains closed until you explicitly configure at least one store.
PURCHASES_ENABLED=false
RECEIPT_ENCRYPTION_KEY=
ANDROID_PACKAGE_NAME=com.cleanchops.arrowthelastlantern
GOOGLE_SIGN_IN_CLIENT_ID=
# Public WEB OAuth client ID (also ARROW_GOOGLE_WEB_CLIENT_ID in Flutter).
# This is not the Android OAuth client ID or a service-account private key.
APPLE_SIGN_IN_BUNDLE_ID=com.cleanchops.arrowthelastlantern
# Apple Developer Team ID and a Sign in with Apple-enabled key, NOT the
# App Store purchase key/issuer ID. Put the .p8 only in a backend secret file.
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY_PATH=
# Google service-account file, outside the source repository:
GOOGLE_APPLICATION_CREDENTIALS=
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Comma-separated paths to Apple Root CA DER certificates downloaded from Apple PKI.
APPLE_ROOT_CERT_PATHS=
# Set true only behind a TLS reverse proxy; configure its exact number of proxy hops.
REQUIRE_HTTPS=false
TRUST_PROXY_HOPS=0
